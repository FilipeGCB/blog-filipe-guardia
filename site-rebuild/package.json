{
  "name": "blog-filipe-guardia-editorial",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "prebuild": "npm run images:build",
    "preview": "astro preview",
    "images:hero": "node scripts/generate-home-hero.mjs",
    "images:build": "node scripts/build-image-variants.mjs && node scripts/generate-home-hero.mjs",
    "images:verify": "node scripts/verify-image-manifest.mjs && node --experimental-strip-types scripts/verify-responsive-images.mjs",
    "check": "node scripts/verify-content.mjs && node scripts/asset-audit.mjs && npm run images:verify && astro check",
    "test:visual": "playwright test",
    "audit:routes": "node scripts/route-audit.mjs",
    "preserve:legacy": "node scripts/preserve-legacy.mjs"
  },
  "dependencies": {
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.10",
    "typescript": "^6.0.3"
  }
}
