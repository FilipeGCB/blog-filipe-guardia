---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntroVisual from '../components/PageIntroVisual.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const timeline = [
  ['2011–2012', 'Fundação operacional', 'Entrada no setor de telecomunicações e entendimento de como contratos, faturamento, atendimento e processos internos protegem a receita.'],
  ['2012–2016', 'Cobrança e contas a receber', 'Especialização em inadimplência, carteira vencida, aging, provisão, recuperação, acordos e impacto financeiro.'],
  ['2016–2023', 'Planejamento e inteligência', 'Evolução para segmentação, dimensionamento, indicadores, canais, custos operacionais e governança.'],
  ['2023–2026', 'Consultoria e transformação', 'Integração entre negócio, dados, processos, discovery, MVPs, backlogs e validação com áreas técnicas.'],
  ['2025–atual', 'IA, produtos e software', 'Construção de produtos, automações e agentes com segurança, supervisão e rastreabilidade.']
];
---
<BaseLayout title="Sobre Filipe Guardia" description="Trajetória profissional de Filipe Guardia, da cobrança B2B à construção de produtos e soluções inteligentes." canonicalPath="/sobre.html" currentPath="/sobre.html">
  <PageIntroVisual
    eyebrow="Filipe Guardia Cano Batista"
    title="Da cobrança e dos dados à construção de <em>sistemas úteis</em>."
    deck="Minha trajetória foi construída em operações financeiras complexas. Comecei entendendo a execução, evoluí para planejamento e inteligência de cobrança e hoje atuo na conexão entre negócio, dados, processos, automação e tecnologia."
    theme="night"
    assetId="portrait:filipe:about"
    currentLabel="Da operação para sistemas"
  />

  <section class="section section-tinted">
    <div class="editorial-shell split-copy">
      <div>
        <span class="section-kicker">Posicionamento atual</span>
        <h2>Uma ponte entre problema, processo, produto, dados e engenharia.</h2>
      </div>
      <div class="copy-stack">
        <p>Atuo como consultor de planejamento e inteligência de cobrança B2B, conectando dados, processos, automação e inteligência artificial.</p>
        <p>Não busco uma carreira puramente técnica. Busco ser a ponte qualificada entre a realidade do negócio e a solução que pode ser construída — com visão de MVP, governança, segurança e medição desde o desenho.</p>
        <ul>
          <li>Conhecimento profundo de cobrança B2B e operações financeiras.</li>
          <li>Capacidade de transformar regras dispersas em processos estruturados.</li>
          <li>Tradução entre linguagem operacional, executiva e técnica.</li>
          <li>Atuação da análise inicial ao protótipo e à validação.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="editorial-shell">
      <div class="section-head"><div><span class="section-kicker">Evolução de carreira</span><h2>Cada fase acrescentou uma camada.</h2></div><p>Operação, controle financeiro, planejamento, dados, processos, produtos e inteligência artificial formam a base do trabalho atual.</p></div>
      <div class="timeline-grid timeline-editorial">
        {timeline.map(([period, title, description]) => <article class="timeline-card"><span>{period}</span><h3>{title}</h3><p>{description}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section-tinted">
    <div class="editorial-shell split-copy"><div><span class="section-kicker">Próximo passo</span><h2>Se o problema é real, a conversa começa pelo contexto.</h2></div><div class="copy-stack"><p>O blog é um espaço para tornar o raciocínio público. Os projetos mostram onde esse raciocínio ganha forma. Se fizer sentido conversar sobre uma situação concreta, estou disponível.</p><a class="button" href={href('/contato.html')}>Entrar em contato</a></div></div>
  </section>
</BaseLayout>