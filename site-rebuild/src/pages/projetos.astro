---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCase from '../components/ProjectCase.astro';
import { projects, workMethod } from '../data/projects';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<BaseLayout title="Projetos | Filipe Guardia" description="Projetos que conectam experiência operacional, produto e inteligência artificial." canonicalPath="/projetos.html" currentPath="/projetos.html">
  <section class="page-intro"><div class="page-shell"><span class="eyebrow">Prova de trabalho</span><h1>Projetos que conectam experiência operacional, produto e <em>inteligência</em>.</h1><p class="deck">Não construo projetos apenas para preencher portfólio. Esta página registra iniciativas que fazem parte da minha trajetória, preservando código comercial, infraestrutura privada e informações confidenciais.</p></div></section>
  <section class="section"><div class="page-shell"><div class="section-head"><div><span class="section-kicker">Portfólio real</span><h2>Contexto, abordagem e competência.</h2></div><p>A descrição é intencionalmente direta: mostrar como o trabalho é pensado sem criar uma nova frente de documentação ou expor propriedade intelectual.</p></div><div class="project-grid">{projects.map((project) => <ProjectCase project={project} />)}</div></div></section>
  <section class="section section-tinted"><div class="page-shell"><div class="section-head"><div><span class="section-kicker">Forma de trabalho</span><h2>Como uma necessidade vira solução.</h2></div><p>O processo parte do trabalho real e só depois define qual tecnologia faz sentido.</p></div><div class="path-grid">{workMethod.map(([number, title, description]) => <article class="path-card"><span class="path-number">{number}</span><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
  <section class="section"><div class="page-shell split-copy"><div><span class="section-kicker">Continuidade</span><h2>Conheça também a trajetória por trás dos projetos.</h2></div><div class="copy-stack"><p>Experiência operacional não é um detalhe de contexto: é a matéria-prima para decisões melhores, produtos mais realistas e sistemas que conseguem sobreviver ao uso.</p><a class="button-secondary" href={href('/sobre.html')}>Ler sobre a trajetória →</a></div></div></section>
</BaseLayout>
