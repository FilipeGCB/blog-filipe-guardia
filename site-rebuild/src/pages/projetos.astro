---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntroVisual from '../components/PageIntroVisual.astro';
import ProjectVisualCard from '../components/ProjectVisualCard.astro';
import { projects, workMethod } from '../data/projects';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<BaseLayout title="Projetos | Filipe Guardia" description="Repositórios públicos de Filipe Guardia sobre agentes, decisões, sistemas visuais e IA aplicada." canonicalPath="/projetos.html" currentPath="/projetos.html">
  <PageIntroVisual
    eyebrow="Prova de trabalho · Código público"
    title="Quatro projetos públicos. <em>Quatro problemas diferentes.</em>"
    deck="Esta página é a porta de entrada para os repositórios públicos que melhor representam o que estou construindo hoje. Cada projeto explica o problema que resolve, o que demonstra e leva diretamente ao código no GitHub."
    theme="night"
    currentLabel="Agentes · decisão · autoridade · experiência visual · IA local"
  />

  <section class="section project-proof-section">
    <div class="editorial-shell">
      <div class="section-head">
        <div><span class="section-kicker">Repositórios públicos</span><h2>Entenda primeiro. Abra o código depois.</h2></div>
        <p>Os diagramas abaixo são representações editoriais para explicar a lógica de cada sistema rapidamente. O botão de cada projeto leva ao repositório público real, com README, documentação e código.</p>
      </div>
      <div class="project-proof-list">
        {projects.map((project, index) => <ProjectVisualCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section section-tinted">
    <div class="editorial-shell">
      <div class="section-head"><div><span class="section-kicker">Forma de trabalho</span><h2>O padrão por trás dos projetos.</h2></div><p>Os produtos mudam, mas o processo é parecido: começar pelo problema real, estruturar restrições, construir de forma incremental e validar a saída concreta.</p></div>
      <div class="project-method-grid">
        {workMethod.map(([number, title, description]) => <article class="path-card"><span class="path-number">{number}</span><h3>{title}</h3><p>{description}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="editorial-shell split-copy">
      <div><span class="section-kicker">Mais contexto</span><h2>O código mostra o que construo. O blog mostra como penso.</h2></div>
      <div class="copy-stack">
        <p>Os artigos conectam decisões de arquitetura, trabalho real, agentes, memória, segurança, operação e produto. A página Sobre organiza a trajetória que levou a esses projetos.</p>
        <div class="hero-actions">
          <a class="button-secondary" href={href('/artigos.html')}>Ler os artigos</a>
          <a class="button-secondary" href={href('/sobre.html')}>Conhecer a trajetória</a>
          <a class="text-link" href="https://github.com/FilipeGCB" target="_blank" rel="noopener noreferrer">GitHub completo →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
