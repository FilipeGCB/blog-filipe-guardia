---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntroVisual from '../components/PageIntroVisual.astro';
import ProjectVisualCard from '../components/ProjectVisualCard.astro';
import { projects, workMethod } from '../data/projects';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<BaseLayout title="Projetos | Filipe Guardia" description="Projetos que conectam experiência operacional, produto e inteligência artificial." canonicalPath="/projetos.html" currentPath="/projetos.html">
  <PageIntroVisual
    eyebrow="Prova de trabalho"
    title="Projetos que conectam experiência operacional, produto e <em>inteligência</em>."
    deck="Iniciativas que fazem parte da minha trajetória, apresentadas sem expor código comercial, infraestrutura privada ou informação confidencial."
    theme="night"
    currentLabel="Contexto real · representação editorial quando não há imagem pública"
  />

  <section class="section project-proof-section">
    <div class="editorial-shell">
      <div class="section-head">
        <div><span class="section-kicker">Portfólio real</span><h2>Contexto, abordagem e competência.</h2></div>
        <p>O visual ajuda a explicar a lógica do trabalho; quando não existe screenshot público, a página declara explicitamente que se trata de uma representação editorial.</p>
      </div>
      <div class="project-proof-list">
        {projects.map((project, index) => <ProjectVisualCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section section-tinted">
    <div class="editorial-shell">
      <div class="section-head"><div><span class="section-kicker">Forma de trabalho</span><h2>Como uma necessidade vira solução.</h2></div><p>O processo parte do trabalho real e só depois define qual tecnologia faz sentido.</p></div>
      <div class="project-method-grid">
        {workMethod.map(([number, title, description]) => <article class="path-card"><span class="path-number">{number}</span><h3>{title}</h3><p>{description}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="editorial-shell split-copy"><div><span class="section-kicker">Continuidade</span><h2>Conheça também a trajetória por trás dos projetos.</h2></div><div class="copy-stack"><p>Experiência operacional não é um detalhe de contexto: é a matéria-prima para decisões melhores, produtos mais realistas e sistemas que conseguem sobreviver ao uso.</p><a class="button-secondary" href={href('/sobre.html')}>Ler sobre a trajetória →</a></div></div>
  </section>
</BaseLayout>
