---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntroVisual from '../../components/PageIntroVisual.astro';
import { guideCompatibility, portableGuides, type PortableGuide } from '../../data/guides';

export function getStaticPaths() {
  return portableGuides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide }
  }));
}

interface Props {
  guide: PortableGuide;
}

const { guide } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<BaseLayout
  title={`${guide.title} | Biblioteca de Métodos | Filipe Guardia`}
  description={guide.summary}
  canonicalPath={`/guias/${guide.slug}.html`}
  currentPath="/biblioteca.html"
>
  <PageIntroVisual
    eyebrow={`Método ${guide.id} · ${guide.category}`}
    title={guide.title}
    deck={guide.summary}
    theme="night"
    currentLabel={guide.skillUrl ? 'Agente portátil · Guia mestre · Skill oficial' : 'Agente portátil · Guia mestre'}
  />

  <section class="section guide-detail-section">
    <div class="reading-shell guide-detail-shell">
      <aside class="guide-download-panel" aria-label="Escolher modo de uso">
        <div>
          <strong>Escolha como você quer usar</strong>
          <p><strong>Chat:</strong> um único Markdown autocontido para anexar ao Copilot Chat básico ou outro assistente. <strong>Guia mestre:</strong> o método original, sem reescrita. {guide.skillUrl && <><strong> Skill:</strong> distribuição modular instalável para hosts compatíveis.</>}</p>
          <small>{guideCompatibility.join(' · ')}</small>
        </div>
        <div class="guide-download-panel-actions">
          <a class="button guide-agent-download" href={href(`/agentes/${guide.slug}.md`)} download>Ativar no Chat (.md)</a>
          <a class="button-secondary" href={href(`/guias/${guide.slug}.md`)} download>Guia mestre original</a>
          {guide.skillUrl && (
            <a class="button-secondary" href={guide.skillUrl} target="_blank" rel="noreferrer">Instalar Skill ↗</a>
          )}
        </div>
      </aside>

      <div class="guide-detail-block">
        <span class="section-kicker">O que faz</span>
        <h2>Para que este método existe</h2>
        <p>{guide.summary}</p>
      </div>

      <div class="guide-detail-block">
        <span class="section-kicker">Quando usar</span>
        <h2>Quando este método faz sentido</h2>
        <p>{guide.activateWhen}</p>
      </div>

      <div class="guide-detail-block">
        <span class="section-kicker">Entradas</span>
        <h2>O que fornecer ao assistente</h2>
        <p>{guide.inputs}</p>
      </div>

      <div class="guide-detail-block">
        <span class="section-kicker">Processo</span>
        <h2>Como o trabalho deve avançar</h2>
        <ol class="guide-detail-steps">
          {guide.process.map((step) => <li>{step}</li>)}
        </ol>
      </div>

      <div class="guide-detail-grid">
        <div class="guide-detail-block">
          <span class="section-kicker">Entrega</span>
          <h2>Resultado esperado</h2>
          <p>{guide.delivery}</p>
        </div>
        <div class="guide-detail-block">
          <span class="section-kicker">Qualidade</span>
          <h2>Gate de qualidade</h2>
          <p>{guide.quality}</p>
        </div>
      </div>

      <div class="guide-detail-block">
        <span class="section-kicker">Exemplos</span>
        <h2>Como pedir</h2>
        <ul class="guide-example-list">
          {guide.examples.map((example) => <li>“{example}”</li>)}
        </ul>
      </div>

      <div class="guide-detail-block">
        <span class="section-kicker">Onde usar</span>
        <h2>O mesmo método em níveis diferentes</h2>
        <p>Use o agente portátil quando você só tem um chat com suporte a arquivos ou contexto Markdown. Use o guia mestre quando quiser estudar/adaptar o método. {guide.skillUrl ? 'Este método também possui uma Skill oficial para ambientes compatíveis.' : 'Uma Skill instalável só deve ser oferecida quando existir um pacote real e testado para esse método.'}</p>
      </div>

      <p><a class="text-link" href={href('/biblioteca.html')}>← Voltar à biblioteca</a></p>
    </div>
  </section>
</BaseLayout>
