---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<BaseLayout title="Contato | Filipe Guardia" description="Converse sobre operações, dados, produtos e IA aplicada." canonicalPath="/contato.html" currentPath="/contato.html">
  <section class="page-intro"><div class="page-shell"><span class="eyebrow">Contato profissional</span><h1>Vamos conversar sobre <em>contexto</em>?</h1><p class="deck">Use o formulário para propostas profissionais, troca de experiências, convites para projetos ou conversas sobre os temas publicados no blog.</p></div></section>
  <section class="section"><div class="page-shell split-copy"><div><span class="section-kicker">Envie uma mensagem</span><h2>Conte brevemente o problema e o objetivo da conversa.</h2><p class="prose-lead">Quanto mais contexto você compartilhar, melhor consigo entender se há uma boa próxima pergunta.</p></div><form class="contact-form" action="https://formspree.io/f/mjkdlljg" method="POST"><div class="field"><label for="name">Nome</label><input id="name" name="name" autocomplete="name" required /></div><div class="field"><label for="email">E-mail</label><input id="email" name="email" type="email" autocomplete="email" required /></div><div class="field"><label for="company">Empresa ou função (opcional)</label><input id="company" name="company" autocomplete="organization" /></div><div class="field"><label for="subject">Assunto</label><input id="subject" name="subject" required /></div><div class="field"><label for="message">Mensagem</label><textarea id="message" name="message" required></textarea></div><button class="button" type="submit">Enviar mensagem</button><p class="status-note">O formulário usa o endpoint público já configurado no site. Não inclua dados confidenciais de clientes ou operação.</p></form></div></section>
  <section class="section section-tinted"><div class="page-shell"><div class="section-head"><div><span class="section-kicker">Outros caminhos</span><h2>Veja o trabalho antes de escrever.</h2></div><p>Você também pode conhecer o código público, os projetos em evolução e a trajetória profissional.</p></div><div class="path-grid"><article class="path-card"><span class="path-number">01</span><h3>GitHub</h3><p>Repositórios e projetos públicos.</p><a href="https://github.com/FilipeGCB" target="_blank" rel="noopener noreferrer">Abrir GitHub →</a></article><article class="path-card"><span class="path-number">02</span><h3>Projetos</h3><p>Portfólio profissional em construção.</p><a href={href('/projetos.html')}>Ver projetos →</a></article><article class="path-card"><span class="path-number">03</span><h3>Trajetória</h3><p>Experiência, competências e direção de carreira.</p><a href={href('/sobre.html')}>Conhecer trajetória →</a></article></div></div></section>
</BaseLayout>
