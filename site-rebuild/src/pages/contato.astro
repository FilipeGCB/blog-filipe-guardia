---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<BaseLayout title="Contato | Filipe Guardia" description="Converse sobre operações, dados, produtos e IA aplicada." canonicalPath="/contato.html" currentPath="/contato.html">
  <section class="utility-night utility-contact-intro">
    <div class="editorial-shell utility-intro-grid">
      <div class="utility-intro-copy">
        <span class="eyebrow">Contato profissional</span>
        <h1>Vamos começar pelo <em>contexto</em>.</h1>
        <p>Propostas profissionais, troca de experiências, projetos ou conversas sobre os temas do blog. A melhor primeira mensagem explica o problema, o objetivo e o que já foi tentado.</p>
      </div>
      <div class="utility-intro-sequence" aria-label="Boa conversa começa por três pontos">
        <span>Problema</span><i>→</i><span>Contexto</span><i>→</i><span>Próxima pergunta</span>
      </div>
    </div>
  </section>

  <section class="section utility-contact-section">
    <div class="editorial-shell split-copy contact-layout">
      <div>
        <span class="section-kicker">Envie uma mensagem</span>
        <h2>Conte brevemente o problema e o objetivo da conversa.</h2>
        <p class="prose-lead">Quanto mais contexto você compartilhar, melhor consigo entender se há uma boa próxima pergunta.</p>
      </div>
      <form class="contact-form" action="https://formspree.io/f/mjkdlljg" method="POST">
        <div class="field"><label for="name">Nome</label><input id="name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="email">E-mail</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="company">Empresa ou função (opcional)</label><input id="company" name="company" autocomplete="organization" /></div>
        <div class="field"><label for="subject">Assunto</label><input id="subject" name="subject" required /></div>
        <div class="field"><label for="message">Mensagem</label><textarea id="message" name="message" required></textarea></div>
        <button class="button" type="submit">Enviar mensagem</button>
        <p class="status-note">O formulário usa o endpoint público já configurado no site. Não inclua dados confidenciais de clientes ou operação.</p>
      </form>
    </div>
  </section>

  <section class="section section-tinted">
    <div class="editorial-shell">
      <div class="section-head"><div><span class="section-kicker">Antes de escrever</span><h2>Veja o trabalho e escolha o melhor ponto de partida.</h2></div><p>Projetos, trajetória e código público ajudam a dar contexto à conversa.</p></div>
      <div class="path-grid">
        <article class="path-card"><span class="path-number">01</span><h3>GitHub</h3><p>Repositórios e projetos públicos.</p><a href="https://github.com/FilipeGCB" target="_blank" rel="noopener noreferrer">Abrir GitHub →</a></article>
        <article class="path-card"><span class="path-number">02</span><h3>Projetos</h3><p>Portfólio profissional em construção.</p><a href={href('/projetos.html')}>Ver projetos →</a></article>
        <article class="path-card"><span class="path-number">03</span><h3>Trajetória</h3><p>Experiência, competências e direção de carreira.</p><a href={href('/sobre.html')}>Conhecer trajetória →</a></article>
      </div>
    </div>
  </section>
</BaseLayout>
