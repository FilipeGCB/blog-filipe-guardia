---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;

const whatsapp = 'https://wa.me/5511970641955';
const telegram: string | null = null;
---
<BaseLayout title="Contato | Filipe Guardia" description="Fale diretamente com Filipe Guardia sobre projetos, sistemas, dados e IA aplicada." canonicalPath="/contato.html" currentPath="/contato.html">
  <section class="utility-night utility-contact-intro">
    <div class="editorial-shell utility-intro-grid">
      <div class="utility-intro-copy">
        <span class="eyebrow">Contato direto</span>
        <h1>Quer conversar? <em>Fale comigo.</em></h1>
        <p>Projetos, troca de experiências, tecnologia, dados, IA ou algum trabalho publicado aqui. Você pode me escrever diretamente ou usar o formulário abaixo.</p>
      </div>
      <div class="utility-intro-sequence" aria-label="Canais de contato">
        <span>E-mail</span><i>→</i><span>WhatsApp</span><i>→</i><span>Conversa</span>
      </div>
    </div>
  </section>

  <section class="section direct-contact-section">
    <div class="editorial-shell">
      <div class="section-head">
        <div><span class="section-kicker">Canais diretos</span><h2>Escolha o jeito mais simples.</h2></div>
        <p>E-mail e WhatsApp são os canais diretos publicados. O GitHub fica disponível para quem quiser conhecer os projetos antes de entrar em contato.</p>
      </div>
      <div class="contact-channel-grid">
        <article class="contact-channel contact-channel-primary">
          <span class="path-number">01</span>
          <h3>E-mail</h3>
          <p>Para conversas, propostas, dúvidas ou troca sobre os projetos do blog.</p>
          <a class="button" href="mailto:filipeguardia@gmail.com">filipeguardia@gmail.com</a>
        </article>
        <article class="contact-channel">
          <span class="path-number">02</span>
          <h3>WhatsApp</h3>
          <p>Mensagem direta pelo WhatsApp.</p>
          <a class="button-secondary" href={whatsapp} target="_blank" rel="noopener noreferrer">Abrir WhatsApp</a>
        </article>
        <article class="contact-channel">
          <span class="path-number">03</span>
          <h3>Telefone</h3>
          <p>Contato telefônico direto.</p>
          <a class="button-secondary" href="tel:+5511970641955">+55 11 97064-1955</a>
        </article>
        {telegram && (
          <article class="contact-channel"><span class="path-number">04</span><h3>Telegram</h3><p>Mensagem direta pelo Telegram.</p><a class="button-secondary" href={telegram} target="_blank" rel="noopener noreferrer">Abrir Telegram</a></article>
        )}
        <article class="contact-channel">
          <span class="path-number">04</span>
          <h3>GitHub</h3>
          <p>Para conhecer os projetos públicos e o código antes de entrar em contato.</p>
          <a class="button-secondary" href="https://github.com/FilipeGCB" target="_blank" rel="noopener noreferrer">Abrir GitHub</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-tinted utility-contact-section">
    <div class="editorial-shell split-copy contact-layout">
      <div>
        <span class="section-kicker">Se preferir</span>
        <h2>Envie pelo formulário.</h2>
        <p class="prose-lead">Descreva brevemente o problema, o objetivo e o contexto. Evite incluir dados confidenciais.</p>
      </div>
      <form class="contact-form" action="https://formspree.io/f/mjkdlljg" method="POST">
        <div class="field"><label for="name">Nome</label><input id="name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="email">Seu e-mail</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="subject">Assunto</label><input id="subject" name="subject" required /></div>
        <div class="field"><label for="message">Mensagem</label><textarea id="message" name="message" required></textarea></div>
        <button class="button" type="submit">Enviar mensagem</button>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="editorial-shell">
      <div class="section-head"><div><span class="section-kicker">Antes de escrever</span><h2>Veja o trabalho.</h2></div><p>Projetos e trajetória ajudam a dar contexto para a conversa.</p></div>
      <div class="path-grid">
        <article class="path-card"><span class="path-number">01</span><h3>Projetos</h3><p>Portfólio público e sistemas em construção.</p><a href={href('/projetos.html')}>Ver projetos →</a></article>
        <article class="path-card"><span class="path-number">02</span><h3>Trajetória</h3><p>Experiência, competências e direção profissional.</p><a href={href('/sobre.html')}>Conhecer trajetória →</a></article>
        <article class="path-card"><span class="path-number">03</span><h3>Biblioteca</h3><p>Guias portáteis para trabalhar melhor com assistentes de IA.</p><a href={href('/biblioteca.html')}>Abrir biblioteca →</a></article>
      </div>
    </div>
  </section>
</BaseLayout>
