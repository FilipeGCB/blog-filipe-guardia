---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { libraryCollections } from '../../data/library';

export function getStaticPaths() {
  return libraryCollections.map((collection) => ({ params: { slug: collection.slug }, props: { collection } }));
}

const { collection } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<BaseLayout title={`${collection.title} | Biblioteca`} description={collection.description} canonicalPath={`/biblioteca/${collection.slug}.html`} currentPath="/biblioteca.html">
  <section class="page-intro"><div class="page-shell"><span class="eyebrow">{collection.label} · Biblioteca</span><h1>{collection.title}</h1><p class="deck">{collection.description}</p></div></section>
  <section class="section"><div class="page-shell split-copy"><div><span class="section-kicker">Como usar</span><h2>Comece pela pergunta, não pela ferramenta.</h2></div><div class="copy-stack"><p>Escolha uma fonte conforme o tipo de problema, reúna os insumos necessários e valide a entrega com evidências. A biblioteca existe para reduzir ambiguidade e tornar o trabalho mais repetível.</p><ul><li>Descreva o contexto e o resultado esperado.</li><li>Selecione o método ou fonte que melhor corresponde à tarefa.</li><li>Revise as decisões que exigem conhecimento humano.</li></ul></div></div></section>
  <section class="section section-tinted"><div class="page-shell"><div class="section-head"><div><span class="section-kicker">Próximas fontes</span><h2>Abra a coleção pública.</h2></div><p>Os links abaixo levam ao catálogo original, preservado como uma área própria do repositório.</p></div><div class="path-grid">{collection.links.map((link, index) => <article class="path-card"><span class="path-number">{String(index + 1).padStart(2, '0')}</span><h3>{link.label}</h3><p>Fonte pública relacionada a esta coleção.</p><a href={href(link.href)}>Abrir fonte →</a></article>)}</div></div></section>
  <section class="section"><div class="page-shell"><a class="button-secondary" href={href('/biblioteca.html')}>← Voltar para a biblioteca</a></div></section>
</BaseLayout>
