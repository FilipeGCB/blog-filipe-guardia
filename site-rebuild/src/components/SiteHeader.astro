---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const links = [
  ['/', 'Início'],
  ['/artigos.html', 'Artigos'],
  ['/projetos.html', 'Projetos'],
  ['/biblioteca.html', 'Biblioteca'],
  ['/sobre.html', 'Sobre'],
  ['/contato.html', 'Contato']
];
const normalized = currentPath.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href={href('/')} aria-label="Filipe Guardia — início">
      <span class="brand-mark guardia-brand-mark" aria-hidden="true">
        <img
          class="guardia-brand-static"
          src={href('/assets/brand/guardia-g-hq.webp')}
          alt=""
          width="299"
          height="395"
        />
        <video
          class="guardia-brand-intro"
          autoplay
          muted
          playsinline
          preload="auto"
          aria-hidden="true"
        >
          <source src={href('/assets/brand/guardia-lockup-intro-hq.webm')} type="video/webm" />
        </video>
      </span>
      <span class="brand-copy">
        <span>Filipe Guardia</span>
        <small>B2X · Transformação Digital · IA</small>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-navigation" class="site-nav" aria-label="Navegação principal">
      {links.map(([path, label]) => {
        const active = path === '/' ? normalized === '/' : normalized.startsWith(path.replace(/\/$/, ''));
        return <a href={href(path)} aria-current={active ? 'page' : undefined}>{label}</a>;
      })}
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.nav-toggle');
  const nav = header?.querySelector('.site-nav');
  const brand = header?.querySelector<HTMLElement>('.brand');
  const intro = brand?.querySelector<HTMLVideoElement>('.guardia-brand-intro');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const close = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('is-open');
    document.body.classList.remove('menu-open');
  };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
    document.body.classList.toggle('menu-open', open);
  });
  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) close();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close();
  });

  let introSettled = false;
  const settleBrand = () => {
    if (introSettled) return;
    introSettled = true;
    brand?.classList.add('brand-intro-settled');
    brand?.classList.remove('brand-intro-active', 'brand-intro-settling');
    intro?.pause();
  };

  const startBrandIntro = async () => {
    if (!brand || !intro || reducedMotion.matches) {
      settleBrand();
      return;
    }

    brand.classList.add('brand-intro-active');
    intro.currentTime = 0;
    try {
      await intro.play();
    } catch {
      settleBrand();
    }
  };

  intro?.addEventListener('timeupdate', () => {
    if (intro.currentTime >= 3.3) brand?.classList.add('brand-intro-settling');
  });
  intro?.addEventListener('ended', settleBrand);
  intro?.addEventListener('error', settleBrand);
  reducedMotion.addEventListener?.('change', (event) => {
    if (event.matches) settleBrand();
  });
  window.setTimeout(settleBrand, 6200);
  void startBrandIntro();
</script>
<style>
  .nav-shell {
    min-height: 94px;
  }

  .brand {
    position: relative;
    isolation: isolate;
    gap: 14px;
    min-width: 0;
  }

  .guardia-brand-mark {
    position: relative;
    display: block;
    width: 64px;
    height: 72px;
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: 0;
    background: transparent;
    color: inherit;
    letter-spacing: normal;
    transition:
      width 760ms cubic-bezier(0.2, 0.78, 0.22, 1),
      height 760ms cubic-bezier(0.2, 0.78, 0.22, 1);
  }

  .guardia-brand-static {
    position: absolute;
    inset: 0;
    width: 64px;
    height: 72px;
    object-fit: contain;
    opacity: 1;
    transition: opacity 180ms ease;
  }

  .guardia-brand-intro {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 0;
    width: 240px;
    height: 90px;
    max-width: none;
    object-fit: contain;
    transform: translate3d(0, -50%, 0);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 180ms ease,
      transform 760ms cubic-bezier(0.2, 0.78, 0.22, 1);
  }

  .brand-intro-active .guardia-brand-mark {
    width: 240px;
    height: 90px;
  }

  .brand-intro-active .guardia-brand-static {
    opacity: 0;
  }

  .brand-intro-active .guardia-brand-intro {
    opacity: 1;
  }

  .brand-intro-settling .guardia-brand-mark,
  .brand-intro-settled .guardia-brand-mark {
    width: 64px;
    height: 72px;
  }

  .brand-intro-settling .guardia-brand-intro,
  .brand-intro-settled .guardia-brand-intro {
    transform: translate3d(-54px, -50%, 0);
  }

  .brand-intro-settled .guardia-brand-intro {
    opacity: 0;
  }

  .brand-intro-settled .guardia-brand-static {
    opacity: 1;
  }

  @media (max-width: 660px) {
    .nav-shell {
      min-height: 84px;
      gap: 12px;
    }

    .brand {
      gap: 10px;
      min-width: 0;
    }

    .guardia-brand-mark {
      width: 54px;
      height: 60px;
    }

    .guardia-brand-static {
      width: 54px;
      height: 60px;
    }

    .guardia-brand-intro {
      width: 160px;
      height: 60px;
    }

    .brand-intro-active .guardia-brand-mark {
      width: 160px;
      height: 60px;
    }

    .brand-intro-settling .guardia-brand-mark,
    .brand-intro-settled .guardia-brand-mark {
      width: 54px;
      height: 60px;
    }

    .brand-intro-settling .guardia-brand-intro,
    .brand-intro-settled .guardia-brand-intro {
      transform: translate3d(-36px, -50%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .guardia-brand-intro {
      display: none;
    }

    .guardia-brand-mark,
    .guardia-brand-static {
      transition: none;
      animation: none;
    }
  }
</style>
