---
import EditorialVisual from './EditorialVisual.astro';

interface Props {
  eyebrow: string;
  title: string;
  deck: string;
  theme?: 'night' | 'editorial';
  assetId?: string;
  currentLabel?: string;
}

const {
  eyebrow,
  title,
  deck,
  theme = 'editorial',
  assetId,
  currentLabel
} = Astro.props;
---
<section class:list={['page-intro-visual', theme === 'night' ? 'page-intro-night' : 'page-intro-editorial']}>
  <div class:list={[theme === 'night' ? 'visual-shell' : 'editorial-shell', 'page-intro-visual-grid', !assetId && 'page-intro-visual-grid-type']}>
    <div class="page-intro-visual-copy">
      <span class="eyebrow">{eyebrow}</span>
      <h1 set:html={title} />
      <p class="deck">{deck}</p>
      {currentLabel && <span class="page-intro-current">{currentLabel}</span>}
      <slot name="actions" />
    </div>
    {assetId ? (
      <EditorialVisual assetId={assetId} className="page-intro-media" loading="eager" />
    ) : (
      <div class="page-intro-signature" aria-hidden="true">
        <span>Operação</span>
        <i>→</i>
        <span>Estrutura</span>
        <i>→</i>
        <span>Sistema</span>
      </div>
    )}
  </div>
</section>
