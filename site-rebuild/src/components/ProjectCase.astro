---
import type { Project } from '../data/projects';

interface Props { project: Project; }
const { project } = Astro.props;
---
<article class:list={['project-card', `project-${project.tone}`]}>
  <span class="section-kicker">{project.label}</span>
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  <ul>
    {project.details.map((detail) => <li>{detail}</li>)}
  </ul>
  <p class="project-proof"><strong>O que demonstra:</strong> {project.proof}</p>
</article>
