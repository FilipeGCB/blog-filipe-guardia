---
import type { LibraryCollection } from '../data/library';

interface Props { collection: LibraryCollection; }
const { collection } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<article class:list={['library-card', `library-${collection.tone}`]}>
  <span class="section-kicker">{collection.label}</span>
  <h3>{collection.title}</h3>
  <p>{collection.description}</p>
  <div class="card-actions">
    {collection.links.slice(0, 2).map((link) => <a href={href(link.href)}>{link.label} →</a>)}
  </div>
</article>
