---
import type { LibraryCollection } from '../data/library';

interface Props { collection: LibraryCollection; }
const { collection } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const motif = collection.slug.split('-').slice(0, 3);
---
<article class:list={['library-card', 'library-card-premium', `library-${collection.tone}`]}>
  <div class="library-card-code" aria-hidden="true">
    {motif.map((part, index) => <span><b>{String(index + 1).padStart(2, '0')}</b>{part}</span>)}
  </div>
  <div class="library-card-copy">
    <span class="section-kicker">{collection.label}</span>
    <h3>{collection.title}</h3>
    <p>{collection.description}</p>
    <div class="card-actions">
      {collection.links.slice(0, 2).map((link) => <a href={href(link.href)}>{link.label} →</a>)}
    </div>
  </div>
</article>
