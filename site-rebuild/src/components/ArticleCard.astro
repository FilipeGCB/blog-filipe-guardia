---
import EditorialVisual from './EditorialVisual.astro';
import type { Article } from '../data/articles';
import { hasEditorialImage } from '../data/editorialImages';

interface Props {
  article: Article;
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { article, featured = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = `${base}artigos/${article.slug}.html`;
const candidateCoverAssetId = `cover:${article.slug}`;
const coverAssetId = hasEditorialImage(candidateCoverAssetId) ? candidateCoverAssetId : undefined;
---
<article class:list={['article-card', featured && 'article-card-featured']} data-series={article.series} data-motion-reveal>
  <a class="card-visual scroll-reveal-media" href={href} aria-label={`Ler ${article.title}`}>
    <EditorialVisual assetId={coverAssetId} src={coverAssetId ? undefined : article.cover} alt={article.coverAlt} loading={featured ? 'eager' : 'lazy'} />
  </a>
  <div class="card-copy">
    <div class="card-meta">
      <span>{article.series}</span>
      <span>{article.dateLabel}</span>
      <span>{article.readingTime.replace('Leitura de ', '')}</span>
    </div>
    <Heading class="card-title"><a href={href}>{article.title}</a></Heading>
    <p>{article.deck}</p>
    <div class="card-actions">
      <span class="text-link">Ler artigo →</span>
      <span class="meta-label">{article.category.split(' & ')[0]}</span>
    </div>
  </div>
</article>
