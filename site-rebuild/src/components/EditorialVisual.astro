---
import { getEditorialImage, type EditorialImageVariant } from '../data/editorialImages';

interface Props {
  assetId?: string;
  src?: string;
  alt?: string;
  caption?: string;
  className?: string;
  loading?: 'eager' | 'lazy';
}

const {
  assetId,
  src,
  alt,
  caption,
  className = '',
  loading = 'lazy'
} = Astro.props;

if (!assetId && !src) {
  throw new Error('EditorialVisual requires assetId or src.');
}

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = assetId ? getEditorialImage(assetId) : undefined;
const effectiveAlt = asset?.alt ?? alt ?? '';

if (!effectiveAlt.trim()) {
  throw new Error(`EditorialVisual requires alt text${assetId ? ` for ${assetId}` : ''}.`);
}

const resolvePath = (path: string) => `${base}${path.replace(/^\//, '')}`;
const srcset = (items: EditorialImageVariant[], key: 'avif' | 'webp') =>
  items.map((item) => `${resolvePath(item[key])} ${item.width}w`).join(', ');

const fallbackSrc = asset
  ? resolvePath(asset.variants.at(-1)?.webp ?? asset.variants[0].webp)
  : resolvePath(src!);
const focalStyle = asset
  ? `--image-focal-point:${asset.focalPoint};--image-focal-point-mobile:${asset.mobile?.focalPoint ?? asset.focalPoint};`
  : undefined;
---
<figure class:list={['editorial-frame', className]}>
  {asset ? (
    <picture>
      {asset.mobile && (
        <>
          <source
            media={asset.mobile.media}
            type="image/avif"
            srcset={srcset(asset.mobile.variants, 'avif')}
            sizes="100vw"
          />
          <source
            media={asset.mobile.media}
            type="image/webp"
            srcset={srcset(asset.mobile.variants, 'webp')}
            sizes="100vw"
          />
        </>
      )}
      <source type="image/avif" srcset={srcset(asset.variants, 'avif')} sizes={asset.sizes} />
      <source type="image/webp" srcset={srcset(asset.variants, 'webp')} sizes={asset.sizes} />
      <img
        src={fallbackSrc}
        alt={effectiveAlt}
        width={asset.width}
        height={asset.height}
        sizes={asset.sizes}
        loading={loading}
        decoding="async"
        fetchpriority={loading === 'eager' ? 'high' : undefined}
        style={focalStyle}
      />
    </picture>
  ) : (
    <img src={fallbackSrc} alt={effectiveAlt} loading={loading} decoding="async" />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
