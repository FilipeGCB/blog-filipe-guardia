---
import type { PortableGuide } from '../data/guides';

interface Props {
  guide: PortableGuide;
}

const { guide } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const page = href(`/guias/${guide.slug}.html`);
const agent = href(`/agentes/${guide.slug}.md`);
const master = href(`/guias/${guide.slug}.md`);
---
<article class="guide-card" data-guide-id={guide.id} data-guide-slug={guide.slug}>
  <div class="guide-card-head">
    <span class="guide-id">{guide.id}</span>
    <h4>{guide.title}</h4>
  </div>

  <div class="guide-card-fact">
    <strong>O que faz</strong>
    <p>{guide.summary}</p>
  </div>

  <div class="guide-activation">
    <strong>Use quando</strong>
    <p>{guide.activateWhen}</p>
  </div>

  <div class="guide-delivery">
    <strong>Entrega</strong>
    <p>{guide.delivery}</p>
  </div>

  <div class="guide-where">
    <strong>Onde usar</strong>
    <p>
      Agente portátil: Copilot Chat básico, ChatGPT, Claude, Codex e outros chats com Markdown.
      {guide.skillUrl && <> <span class="guide-skill-available">Skill oficial também disponível.</span></>}
    </p>
  </div>

  <div class="guide-card-actions">
    <a class="button guide-agent-download" href={agent} download>Ativar no Chat (.md)</a>
    <a class="text-link guide-open" href={page}>Ver método</a>
    <a class="text-link guide-download" href={master} download>Guia mestre</a>
    {guide.skillUrl && (
      <a class="text-link guide-skill-link" href={guide.skillUrl} target="_blank" rel="noreferrer">Instalar Skill ↗</a>
    )}
  </div>
</article>
