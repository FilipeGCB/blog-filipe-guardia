---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-shell">
    <div>
      <strong>Filipe Guardia</strong>
      <p>Operação real, dados, sistemas e inteligência artificial aplicada.</p>
    </div>
    <nav aria-label="Links profissionais">
      <a href={href('/artigos.html')}>Artigos</a>
      <a href={href('/projetos.html')}>Projetos</a>
      <a href="https://github.com/FilipeGCB" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={href('/contato.html')}>Contato</a>
    </nav>
    <small>© {year} · Conteúdo autoral de Filipe Guardia.</small>
  </div>
</footer>
